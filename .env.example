# LINE Messaging API（LINE Developers Console → 你的 channel）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Claude API（https://console.anthropic.com → API Keys）
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# 若 API key 未綁 workspace，填 workspace id
ANTHROPIC_WORKSPACE_ID=

# 允許使用 bot 的 LINE userId，逗號分隔；留空時只會在 log 印出來訊者 userId
ALLOWED_USER_IDS=

PORT=47821

# ngrok 固定網域（scripts/murmurctl install 必填，例如 https://xxx.ngrok-free.app）
NGROK_URL=

# 語音分析紀錄 CSV 路徑（選用，相對於執行目錄；預設 data/records.csv，目錄會自動建立）
# RECORDS_PATH=data/records.csv

# 使用者情境檔路徑（選用，相對於執行目錄、支援 ~；預設 context.md，可由 context.example.md 複製）
# CONTEXT_FILE=context.md

# 初始分類，逗號分隔（選用；未設定時用下列預設五類）
# SEED_CATEGORIES=家庭生活,健康醫療,金錢財務,工作事業,閒聊問候

# 語音辨識語系（選用，預設 zh-TW；簡轉繁只在 zh 開頭的語系套用）
# SPEECH_LOCALE=zh-TW
